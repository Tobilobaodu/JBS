# Application
APP_NAME=cv-tailoring-backend
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=local

# Database
DATABASE_URL=postgresql://cvapp:cvapp_local@postgres:5432/cv_tailoring
DATABASE_URL_ASYNC=postgresql+asyncpg://cvapp:cvapp_local@postgres:5432/cv_tailoring

# Redis
REDIS_URL=redis://redis:6379/0

# AWS (for Textract + S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
S3_BUCKET_NAME=cv-tailoring-local

# MinIO (local S3-compatible storage)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Textract
TEXTRACT_ENABLED=false

# LLM provider (Phase 3, placeholder)
OPENAI_API_KEY=placeholder
OPENAI_MODEL=gpt-4o

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=3600

# Rate limiting (tiered per security plan)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_GENERATION_REQUESTS=20
RATE_LIMIT_GENERATION_WINDOW=3600
RATE_LIMIT_URL_FETCH_REQUESTS=20
RATE_LIMIT_URL_FETCH_WINDOW=3600

# Max concurrent in-flight processing jobs per user
MAX_CONCURRENT_JOBS_PER_USER=5

# ClamAV
CLAMD_HOST=clamav
CLAMD_PORT=3310

# CORS
CORS_ORIGIN=http://localhost:3000
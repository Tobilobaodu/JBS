# Base URL of the backend API.
#
# This is a NEXT_PUBLIC_* variable, so its value is compiled into the client
# bundle at build time — setting it at runtime has no effect. In the deployed
# stack it is passed as a Docker build arg (see backend/docker-compose.prod.yml);
# here it only covers local `npm run dev`.
#
# Local:    http://localhost:8000
# Deployed: https://jbs-api.tobilobaodu.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
